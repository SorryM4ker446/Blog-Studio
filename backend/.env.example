DB_DSN=host=localhost user=postgres password=your_password dbname=blog_db port=5432 sslmode=disable TimeZone=Asia/Shanghai
JWT_SECRET=replace_with_at_least_32_random_characters
SERVER_ADDRESS=:8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
TRUSTED_PROXIES=
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_MAX_LIFETIME=30m
DB_CONNECTION_MAX_IDLE_TIME=5m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=5m
HTTP_IDLE_TIMEOUT=2m
HTTP_SHUTDOWN_TIMEOUT=20s
HEALTH_CHECK_TIMEOUT=2s

# Required only when running go run ./cmd/seed.
ADMIN_USER=admin
ADMIN_PASS=replace_with_a_strong_password_at_least_12_characters
