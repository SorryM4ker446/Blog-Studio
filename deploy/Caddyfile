{$SITE_ADDRESS} {
	encode zstd gzip

	@backend path /api /api/* /health/live /health/ready
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format json
	}
}
